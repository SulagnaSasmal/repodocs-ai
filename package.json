{
  "name": "repodocs-ai",
  "version": "1.2.3",
  "description": "AI-prompt-powered docs-as-code documentation system for SaaS API teams",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bootstrap:docs-repo": "node scripts/bootstrap-docs-repo.mjs",
    "lint:markdown": "markdownlint \"**/*.md\" --ignore node_modules --ignore archive --ignore exports",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docker:control-plane:build": "docker build -f experimental/deploy/Dockerfile -t repodocs-ai-control-plane .",
    "docker:control-plane:run": "docker run --rm -p 4312:4312 --add-host=host.docker.internal:host-gateway -v repodocs-ai-control-plane-data:/var/data -e REDIS_URL=redis://host.docker.internal:6379 -e REPODOCS_CONTROL_PLANE_HOST=0.0.0.0 -e REPODOCS_CONTROL_PLANE_DATA_DIR=/var/data/control-plane -e REPODOCS_CONTROL_PLANE_BOOTSTRAP_USER=admin -e REPODOCS_CONTROL_PLANE_BOOTSTRAP_KEY=replace-me repodocs-ai-control-plane",
    "generate:openapi:all": "node scripts/generate-all-openapi-docs.mjs",
    "agent:run": "node scripts/run-documentation-agent.mjs examples/openapi/payments-openapi.yaml",
    "analytics:report": "node scripts/generate-analytics-report.mjs",
    "graph:build": "node scripts/build-knowledge-graph.mjs",
    "automation:run": "npm run agent:run && npm run validate:quality && npm run analytics:report && npm run graph:build",
    "export": "node scripts/export-docs.mjs all",
    "export:confluence": "node scripts/export-docs.mjs confluence",
    "export:gdocs": "node scripts/export-docs.mjs gdocs",
    "export:notion": "node scripts/export-docs.mjs notion",
    "export:pdf": "node scripts/export-docs.mjs pdf",
    "control-plane:start": "node scripts/control-plane-server.mjs",
    "control-plane:smoke": "node scripts/control-plane-smoke.mjs",
    "control-plane:stack:up": "docker compose -f experimental/deploy/compose.yaml up -d --build",
    "control-plane:stack:smoke": "docker compose -f experimental/deploy/compose.yaml up -d --build && node scripts/control-plane-smoke.mjs",
    "control-plane:stack:down": "docker compose -f experimental/deploy/compose.yaml down",
    "validate:frontmatter": "node scripts/validate-frontmatter.mjs",
    "validate:structure": "node scripts/validate-structure.mjs",
    "validate:quality": "node scripts/validate-doc-quality.mjs",
    "validate:openapi": "node scripts/validate-openapi-examples.mjs",
    "validate:versions": "node scripts/validate-version-compatibility.mjs",
    "validate:docs": "node scripts/validate-docs.mjs",
    "generate:openapi": "node scripts/generate-openapi-docs.mjs examples/openapi/payments-openapi.yaml generated/payments-platform-api",
    "coverage:check": "node scripts/detect-undocumented-endpoints.mjs",
    "analytics:aggregate": "node scripts/aggregate-analytics.mjs",
    "version:check": "node scripts/check-template-version.mjs",
    "proof:path": "node scripts/run-proof-path.mjs",
    "validate": "npm run validate:frontmatter && npm run validate:structure && npm run validate:quality && npm run validate:openapi && npm run validate:versions && npm run lint:markdown"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "markdownlint-cli": "^0.50.1",
    "redis": "^5.11.0",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "js-yaml": "^4.3.2"
  },
  "bin": {
    "repodocs-ai": "bin/repodocs.mjs"
  },
  "files": [
    "bin/",
    "scripts/bootstrap-docs-repo.mjs",
    "scripts/generate-openapi-docs.mjs",
    "scripts/validate-docs.mjs",
    "scripts/validate-frontmatter.mjs",
    "scripts/validate-doc-quality.mjs",
    "scripts/validate-openapi-examples.mjs",
    "scripts/validate-version-compatibility.mjs",
    "scripts/lib/",
    "templates/",
    "prompts/",
    "diagrams/",
    "schema/",
    "validation/",
    "examples/",
    ".github/pull_request_template.md",
    ".markdownlint.json",
    "TEMPLATE_VERSION",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SulagnaSasmal/repodocs-ai.git"
  },
  "license": "MIT"
}
